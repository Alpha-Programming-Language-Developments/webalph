// WebAlph: IPC & RPC Dispatcher Module
// Processes JSON-RPC requests from window.webalph.invoke and window.webalph.emit

const var std = @import("std")
import events.alpha

public var rpc_commands: map<string, something> = map.new()

function register_rpc(name: string, handler: something) [public, nothing] {
    rpc_commands.insert(name, handler)
}

function has_rpc(name: string) [public, boolean] {
    return rpc_commands.contains(name)
}

function dispatch_rpc(raw_msg: string) [public, string] {
    var parsed: map<string, something> = std.json.parse(raw_msg)
    var msg_type: string = parsed["type"]

    if msg_type == "invoke" {
        var cmd_name: string = parsed["cmd"]
        var id: something = parsed["id"]
        var args: something = parsed["args"]

        if rpc_commands.contains(cmd_name) {
            var handler: something = rpc_commands[cmd_name]
            var res: something = handler(args)
            var res_json: string = std.json.stringify(res)
            return std.format("window.__webalph_resolve({}, {}, false);", id, res_json)
        } else {
            var err_msg: string = std.format("WebAlph: Command '{}' is not registered in backend", cmd_name)
            var err_json: string = std.json.stringify(err_msg)
            return std.format("window.__webalph_resolve({}, {}, true);", id, err_json)
        }
    }

    if msg_type == "emit" {
        var event_name: string = parsed["event"]
        var payload: something = parsed["payload"]

        trigger_event(event_name, payload)
        return ""
    }

    return ""
}
