// WebAlph: Application Lifecycle & Controller Module
// High-level App structure binding Window, IPC, and Event Bus.

const var std = @import("std")
import window.alpha
import events.alpha
import ipc.alpha

public structure App {
    window: WindowConfig,
attach {
    function new(title: string, width: int, height: int, url: string) [static, public, App] {
        var win: WindowConfig = WindowConfig.new(title, width, height, url)
        return make this {
            window: win
        }
    }

    function with_title(title: string) [nonstatic, public, App] {
        this.window.title = title
        return this
    }

    function with_size(width: int, height: int) [nonstatic, public, App] {
        this.window.width = width
        this.window.height = height
        return this
    }

    function with_html(html_content: string) [nonstatic, public, App] {
        this.window.html = html_content
        return this
    }

    function with_url(url: string) [nonstatic, public, App] {
        this.window.url = url
        this.window.html = ""
        return this
    }

    function with_resizable(resizable: boolean) [nonstatic, public, App] {
        this.window.resizable = resizable
        return this
    }

    function command(name: string, handler: something) [nonstatic, public, App] {
        register_rpc(name, handler)
        return this
    }

    function listen(event: string, handler: something) [nonstatic, public, App] {
        on_event(event, handler)
        return this
    }

    function emit(event: string, payload: something) [nonstatic, public, App] {
        emit_event(event, payload)
        return this
    }

    function eval(script: string) [nonstatic, public, App] {
        std.webview.eval(script)
        return this
    }

    function run() [nonstatic, public, nothing] {
        var opts: map<string, something> = this.window.to_map()
        std.webview.open(opts)
        std.webview.on_message(dispatch_rpc)
        std.webview.run()
    }
}
}
