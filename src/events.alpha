// WebAlph: Event Bus Module
// Manages bi-directional event dispatching between Alpha backend and web frontend.

const var std = @import("std")

public var event_listeners: map<string, something> = map.new()

function on_event(event_name: string, handler: something) [public, nothing] {
    event_listeners.insert(event_name, handler)
}

function has_event(event_name: string) [public, boolean] {
    return event_listeners.contains(event_name)
}

function trigger_event(event_name: string, payload: something) [public, nothing] {
    if event_listeners.contains(event_name) {
        var handler: something = event_listeners[event_name]
        handler(payload)
    }
}

function emit_event(event_name: string, payload: something) [public, nothing] {
    var payload_json: string = std.json.stringify(payload)
    var script: string = std.format("window.__webalph_dispatch('{}', {});", event_name, payload_json)
    std.webview.eval(script)
}
