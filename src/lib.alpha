const var std = @import("std")

import window.alpha
import events.alpha
import ipc.alpha
import app.alpha

// Helper constructor for quick application bootstrapping
function create_app(title: string, width: int, height: int, url: string) [public, App] {
    return App.new(title, width, height, url)
}
