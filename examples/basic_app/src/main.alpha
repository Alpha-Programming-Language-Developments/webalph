// ============================================================================
// WebAlph: Пример простого десктопного приложения
// ============================================================================
// Этот пример показывает 3 главные вещи:
// 1. Как открыть окно приложения (App.new + app.run)
// 2. Как обрабатывать команды из JavaScript (app.command + invoke)
// 3. Как обмениваться событиями в реальном времени (app.listen + app.emit)
// ============================================================================

import Core/Basic.alpha
import Core/Json.alpha
import Core/Env.alpha
import Core/Time.alpha
import "../../src/lib.alpha"

// ----------------------------------------------------------------------------
// 1. Обработчики RPC-команд (вызываются из JS через window.webalph.invoke)
// ----------------------------------------------------------------------------

// Команда 1: Приветствие по имени (возвращает строку)
// Вызов из JS: await window.webalph.invoke("greet", { name: "Иван" })
function handle_greet(args: map<string, something>) [here, string] {
    var name: string = args["name"]
    return format("Привет, {}! Это сообщение сгенерировано на бэкенде Alpha.", name)
}

// Команда 2: Сложение двух чисел на бэкенде (возвращает число)
// Вызов из JS: await window.webalph.invoke("calculate", { a: 10, b: 20 })
function handle_calculate(args: map<string, something>) [here, int] {
    var a: int = args["a"]
    var b: int = args["b"]
    return a + b
}

// Команда 3: Получение системной информации (возвращает словарь/JSON)
// Вызов из JS: await window.webalph.invoke("get_system_info", {})
function handle_system_info(args: map<string, something>) [here, map<string, something>] {
    var info: map<string, something> = map.new()
    info.insert("platform", "Alpha Native (WebView2 / WRY)")
    info.insert("engine_version", "0.1.0")
    info.insert("working_dir", env.current)
    info.insert("timestamp_ms", time.now_ms())
    return info
}

// ----------------------------------------------------------------------------
// 2. Обработчик события (вызывается из JS через window.webalph.emit)
// ----------------------------------------------------------------------------
function handle_ping(payload: something) [here, nothing] {
    printf("[Alpha] Получено событие 'ping' из веб-интерфейса: {}\n", json.stringify(payload))

    // Формируем ответное событие "pong" для фронтенда
    var response: map<string, something> = map.new()
    response.insert("message", "Ответный сигнал 'pong' от Alpha!")
    response.insert("server_time", time.now_ms())

    // Отправляем событие во фронтенд (JS поймает его через window.webalph.listen("pong", ...))
    emit_event("pong", response)
}

// ----------------------------------------------------------------------------
// 3. Точка входа: создание и запуск приложения
// ----------------------------------------------------------------------------
function main() [here, nothing] {
    printf("[WebAlph] Запуск десктопного приложения...\n")

    // Шаг 1: Настраиваем окно (Заголовок, Ширина, Высота, Путь к HTML файлу)
    var app: App = App.new("WebAlph Demo App", 980, 700, "ui/index.html")

    // Шаг 2: Регистрируем команды, доступные для JavaScript
    app.command("greet", handle_greet)
    app.command("calculate", handle_calculate)
    app.command("get_system_info", handle_system_info)

    // Шаг 3: Регистрируем слушатель входящих событий из JavaScript
    app.listen("ping", handle_ping)

    // Шаг 4: Открываем окно и запускаем приложение!
    // (Код ниже app.run() выполнится только когда окно будет закрыто)
    app.run()

    printf("[WebAlph] Окно закрыто. Приложение завершило работу.\n")
}
