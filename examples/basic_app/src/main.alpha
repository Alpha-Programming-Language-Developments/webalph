// ============================================================================
// WebAlph: Simple Desktop Application Example
// ============================================================================
// This example demonstrates 3 core concepts:
// 1. Opening an application window (App.new + app.run)
// 2. Handling RPC commands from JavaScript (app.command + invoke)
// 3. Real-time bi-directional event communication (app.listen + emit_event)
// ============================================================================

const var std = @import("std")
import webalph

// ----------------------------------------------------------------------------
// 1. RPC Command Handlers (invoked from JS via window.webalph.invoke)
// ----------------------------------------------------------------------------

// Command 1: Greet by name (returns string)
// Invocation from JS: await window.webalph.invoke("greet", { name: "John" })
function handle_greet(args: map<string, something>) [here, string] {
    var name: string = args["name"]
    return std.format("Hello, {}! This message was generated on the Alpha backend.", name)
}

// Command 2: Add two numbers on the backend (returns integer)
// Invocation from JS: await window.webalph.invoke("calculate", { a: 10, b: 20 })
function handle_calculate(args: map<string, something>) [here, int] {
    var a: int = args["a"]
    var b: int = args["b"]
    return a + b
}

// Command 3: Retrieve system information (returns map/JSON object)
// Invocation from JS: await window.webalph.invoke("get_system_info", {})
function handle_system_info(args: map<string, something>) [here, map<string, something>] {
    var info: map<string, something> = map.new()
    info.insert("platform", "Alpha Native (WebView2 / WRY)")
    info.insert("engine_version", "0.2.0")
    info.insert("working_dir", std.env.current)
    info.insert("timestamp_ms", std.time.now_ms())
    return info
}

// ----------------------------------------------------------------------------
// 2. Event Handler (triggered from JS via window.webalph.emit)
// ----------------------------------------------------------------------------
function handle_ping(payload: something) [here, nothing] {
    std.printf("[Alpha] Received 'ping' event from frontend: {}\n", std.json.stringify(payload))

    // Prepare response "pong" event payload for frontend
    var response: map<string, something> = map.new()
    response.insert("message", "Pong response signal from Alpha!")
    response.insert("server_time", std.time.now_ms())

    // Emit event to frontend (caught in JS via window.webalph.listen("pong", ...))
    emit_event("pong", response)
}

// ----------------------------------------------------------------------------
// 3. Entry Point: Application setup and launch
// ----------------------------------------------------------------------------
function main() [public, nothing] {
    std.println("[WebAlph] Starting desktop application...")

    // Step 1: Configure window (Title, Width, Height, Path to HTML file)
    var app: App = App.new("WebAlph Demo App", 980, 700, "ui/index.html")

    // Step 2: Register RPC commands callable from JavaScript
    app.command("greet", handle_greet)
    app.command("calculate", handle_calculate)
    app.command("get_system_info", handle_system_info)

    // Step 3: Register event listener for incoming frontend events
    app.listen("ping", handle_ping)

    // Step 4: Open window and run event loop!
    // (Code after app.run() executes only when the window is closed)
    app.run()

    std.println("[WebAlph] Window closed. Application terminated.")
}
